{
  "name": "apex-rental-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "bash scripts/db-test.sh",
    "db:reset:local": "bash scripts/db-reset-local.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "node scripts/gen-db-types.mjs",
    "stack:up": "node tools/local-stack/stack.mjs",
    "stack:fresh": "node tools/local-stack/stack.mjs --fresh",
    "test:stack": "bash -c \"set -a; . tools/local-stack/.data/stack.env; set +a; pnpm --filter @rental/server test:stack\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@next/eslint-plugin-next": "^15.5.26",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}