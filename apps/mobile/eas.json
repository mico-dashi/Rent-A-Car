{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.11.0",
      "pnpm": "10.33.0",
      "env": { "APP_VARIANT": "universal" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_ENV": "preview" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    },
    "apex-drive-preview": {
      "extends": "preview",
      "env": { "APP_VARIANT": "apex-drive", "APP_ENV": "preview" }
    },
    "apex-drive-production": {
      "extends": "production",
      "env": { "APP_VARIANT": "apex-drive", "APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
