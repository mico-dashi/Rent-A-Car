# Copy to .env.local (web) / apps/mobile/.env (mobile). NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ / EXPO_PUBLIC_ are shipped to browsers/devices: never put secrets in them.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used by booking creation, webhooks and cron routes only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform ---
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_NAME=Rental Platform
# Development only: tenant served on plain http://localhost:3000 (ignored in production)
DEV_TENANT_SLUG=apex-drive
# Shared secret for scheduled jobs (POST /api/v1/cron/*), >= 24 chars
CRON_SECRET=

# --- Payments (Stripe; use test keys until go-live) ---
PAYMENTS_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications ---
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXPO_ACCESS_TOKEN=

# --- Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Rate limiting (multi-instance deployments) ---
RATE_LIMIT_REDIS_URL=

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
APP_VARIANT=universal
APP_ENV=development

# --- Supabase Auth providers (supabase/config.toml) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
